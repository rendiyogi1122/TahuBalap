      <span class=sf-dump-index>1</span> => \"<span class=sf-dump-str title=\"55 characters\">Haluskan kacang sangrai bersama bawang putih dan cabai.</span>\"
      <span class=sf-dump-index>2</span> => \"<span class=sf-dump-str title=\"60 characters\">Tambahkan kecap manis, air jeruk, garam, dan air. Aduk rata.</span>\"
