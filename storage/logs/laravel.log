    \"<span class=sf-dump-key>deskripsi</span>\" => \"<span class=sf-dump-str title=\"109 characters\">Tahu putih dipanggang dengan marinade jahe dan wijen. Light, healthy, dan penuh cita rasa Asia yang autentik.</span>\"
