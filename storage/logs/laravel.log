      <span class=sf-dump-index>0</span> => \"<span class=sf-dump-str title=\"76 characters\">Potong tahu dadu 2cm. Baluri dengan maizena, goreng hingga krispi. Sisihkan.</span>\"
      <span class=sf-dump-index>1</span> => \"<span class=sf-dump-str title=\"55 characters\">Sisakan 1 sdm minyak, tumis bawang putih hingga kuning.</span>\"
      <span class=sf-dump-index>2</span> => \"<span class=sf-dump-str title=\"53 characters\">Masukkan cabai rawit dan daun bawang, tumis sebentar.</span>\"
      <span class=sf-dump-index>3</span> => \"<span class=sf-dump-str title=\"33 characters\">Masukkan tahu krispi, aduk cepat.</span>\"
      <span class=sf-dump-index>4</span> => \"<span class=sf-dump-str title=\"53 characters\">Tambahkan kaldu bubuk, lada, garam, dan minyak wijen.</span>\"
      <span class=sf-dump-index>5</span> => \"<span class=sf-dump-str title=\"59 characters\">Aduk rata cepat, matikan api. Sajikan segera selagi krispi.</span>\"
