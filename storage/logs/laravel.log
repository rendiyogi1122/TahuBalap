      <span class=sf-dump-index>0</span> => \"<span class=sf-dump-str title=\"86 characters\">Potong tahu menjadi steak setebal 1.5cm, tekan dengan tisu dapur untuk mengurangi air.</span>\"
      <span class=sf-dump-index>1</span> => \"<span class=sf-dump-str title=\"65 characters\">Campurkan kecap asin, minyak wijen, jahe, bawang putih, dan madu.</span>\"
      <span class=sf-dump-index>2</span> => \"<span class=sf-dump-str title=\"43 characters\">Rendam tahu dalam marinade selama 10 menit.</span>\"
      <span class=sf-dump-index>3</span> => \"<span class=sf-dump-str title=\"50 characters\">Panaskan pan anti lengket, tambahkan minyak sayur.</span>\"
      <span class=sf-dump-index>4</span> => \"<span class=sf-dump-str title=\"52 characters\">Panggang tahu 3-4 menit per sisi hingga kecokelatan.</span>\"
      <span class=sf-dump-index>5</span> => \"<span class=sf-dump-str title=\"72 characters\">Taburi wijen dan daun bawang. Sajikan dengan sisa marinade sebagai saus.</span>\"
    </samp>]
